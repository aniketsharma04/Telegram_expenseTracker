    {
      "id": "reports_aaj_complete_finance_roadmap_roadmap_later",
      "label": "Roadmap Later (9+ months): gated on money, entity or partner",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L105",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_monetise_low_price",
      "label": "Monetise with low prices and no product pushing",
      "file_type": "rationale",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L117",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Commission on loans/investments is regulated and fatal to neutrality; Gmail data cannot feed lending; start with donations (Vercel-allowed), then a low-priced Pro/one-time unlock after moving off Vercel Hobby."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_eas_store_build_path",
      "label": "Store-build release path beyond EAS 1,000 MAU",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L57",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The project rule 'OTA updates first' stops working past 1,000 monthly users on Expo Free."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_chat_is_commodity",
      "label": "Chat is a commodity; verified numbers are the moat",
      "file_type": "rationale",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L127",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Google Pay's free multilingual assistant shows chat alone is commoditised; Aaj's edge is verified data across every bank, cash, family and calendar."
    }
