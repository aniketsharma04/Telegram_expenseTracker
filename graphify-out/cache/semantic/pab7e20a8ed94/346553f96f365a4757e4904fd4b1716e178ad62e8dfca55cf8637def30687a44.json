{
  "nodes": [
    {
      "id": "reports_aaj_complete_finance_roadmap_doc",
      "label": "Aaj complete finance roadmap (report)",
      "file_type": "document",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_neutral_money_hub",
      "label": "Aaj as India's neutral money hub",
      "file_type": "rationale",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Every large Indian tracker monetises via loans, cards or investments (axio, Moneyview, INDmoney, CRED); a neutral, chat-first, family-aware tracker covering cash and every bank is an open gap."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_four_differentiators",
      "label": "Four differentiators: cross-source coverage, neutrality, family without sign-ups, coaching layer",
      "file_type": "rationale",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L11",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Google Pay's free Gemini assistant commoditised Hindi chat/voice, so Aaj must win on the combination; privacy is table stakes since indie apps already market on-device parsing."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_user_supplied_documents_strategy",
      "label": "User-supplied documents beat licensed data pipes",
      "file_type": "rationale",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L13",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "AA, bureaus, BBPS and Gmail CASA are closed or costly to an unregistered solo developer; SMS/notification parsing, Gmail forwarding, CAS parsing, statement uploads and upi://pay hand-offs cover nearly the same ground for free."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_data_access_matrix",
      "label": "Data access matrix (free / entity / licence)",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L23",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_track_and_teach_boundary",
      "label": "Track and teach freely; recommend, refer or hold money only with a licence",
      "file_type": "rationale",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L33",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Tracking, budgeting rules and read-only display are not regulated advice; naming securities, loan referrals, fund holding and insurance quotes are regulated by SEBI, RBI and IRDAI."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_free_tier_risks",
      "label": "Free-tier and policy risks to fix before new features",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L43",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Bank text on Gemini free tier, Gmail 100-user cap, Vercel Hobby non-commercial clause, no Supabase backups, mocked BBPS fetch carry legal or data-loss risk."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_on_device_parsing_pipeline",
      "label": "On-device parsing pipeline (regex, Gemini Nano, masked fallback)",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L45",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Gemini Unpaid terms forbid personal info and allow training/human review; bank alerts are highly templated so regex covers most."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_gmail_forward_inbound",
      "label": "Gmail forward-to-inbound address",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L21",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Avoids restricted gmail.readonly scope, 100-user lifetime cap and annual CASA; user controls what is shared."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_mocked_bbps_replacement",
      "label": "Replace mocked BBPS fetch with parsed bills plus upi://pay hand-off",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L54",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A fake bill amount misleads users and implies BBPS access Aaj does not have; no fund handling means no RBI PA or BBPS licence."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_weekly_personalised_review",
      "label": "Weekly personalised review in briefs",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L61",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Megastudy found weekly congratulate/nudge reminders best; monthly or salary-day timing had no effect; effects fade so nudging should be permanent."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_sinking_funds",
      "label": "Sinking funds for Diwali, weddings, school fees and premiums",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L65",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_family_without_signups",
      "label": "Family tracking without forced sign-ups",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L65",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "INDmoney's family view requires every member to hold an account; Aaj can let one person track a parent or household."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_ask_your_money",
      "label": "Ask your money with fixed typed tools and deterministic numbers",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L67",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Model chooses tools, SQL/TS computes numbers, model only phrases reply; framed as 'not an advisor' for SEBI reasons."
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_roadmap_now",
      "label": "Roadmap Now (0-3 months): legal, safe and sticky",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L73",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "reports_aaj_complete_finance_roadmap_roadmap_next",
      "label": "Roadmap Next (3-9 months): earn the all-in-one-place claim",
      "file_type": "concept",
      "source_file": "reports/Aaj complete finance roadmap.md",
      "source_location": "L89",
      "source_url": null,
      "captured_at": null,
