{
  "expo": {
    "name": "Aaj",
    "slug": "aniket-sharma",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "expensetracker",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aniketsharma.expensetracker"
    },
    "android": {
      "package": "com.aniketsharma.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Snap receipts to log expenses automatically."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record short voice notes to log expenses hands-free.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f766e",
          "defaultChannel": "daily"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c9e5fb51-3cb2-42e1-b57b-51900c7704ef"
      }
    },
    "owner": "aniketsharma054s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c9e5fb51-3cb2-42e1-b57b-51900c7704ef",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
