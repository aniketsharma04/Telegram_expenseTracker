# ── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Any random string you invent; sent by Telegram on every webhook call and
# verified by the webhook route. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me

# Optional but recommended (single-user tool): your numeric Telegram chat id.
# Message @userinfobot to find it. Leave empty to accept any chat.
TELEGRAM_ALLOWED_CHAT_ID=

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + service role key (server-side only, bypasses RLS — used by the
# webhook to write expenses). Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key (read-only via RLS) — used by the dashboard in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── v2: LLM fallback parsing (optional but recommended) ────────────────────
# Powers parsing of messy phrasing the rules parser can't handle. Set ONE of
# these; Gemini wins if both are present. Without either, v1 behavior.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model override (default: gemini-2.5-flash for Gemini, claude-opus-5 for Claude)
LLM_MODEL=

# ── v2: Voice-note transcription (optional) ─────────────────────────────────
# Free key from console.groq.com — transcribes Telegram voice notes.
GROQ_API_KEY=

# ── Webhook registration (scripts/set-webhook.mjs) ──────────────────────────
# The public URL of the deployed app, no trailing slash
APP_URL=https://your-app.vercel.app

# ── v6: BBPS bill fetch via Setu (optional) ─────────────────────────────────
# Without these the Bills tab uses the built-in demo billers. Create a
# sandbox BBPS BillPay product instance at https://bridge.setu.co and copy:
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PARTNER_ID=
# Only if your product instance shows one; sandbox works without it.
SETU_AGENT_ID=
# Defaults to the sandbox host; set to the production host when live.
SETU_BASE_URL=https://sandbox-coudc.setu.co
# Fallback mobile sent with fetch requests when the user has none on file.
SETU_DEFAULT_MOBILE=
# Set to "mock" to force the demo billers even with keys present.
BBPS_PROVIDER=
