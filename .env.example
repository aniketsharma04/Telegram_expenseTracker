# ── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Any random string you invent; sent by Telegram on every webhook call and
# verified by the webhook route. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me

# Optional but recommended (single-user tool): your numeric Telegram chat id.
# Message @userinfobot to find it. Leave empty to accept any chat.
TELEGRAM_ALLOWED_CHAT_ID=

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + service role key (server-side only, bypasses RLS — used by the
# webhook to write expenses). Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key (read-only via RLS) — used by the dashboard in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Webhook registration (scripts/set-webhook.mjs) ──────────────────────────
# The public URL of the deployed app, no trailing slash
APP_URL=https://your-app.vercel.app
